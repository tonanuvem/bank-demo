# =============================================================================
# Variaveis usadas pelos dois docker-compose-*-otel.
#   cp .env.otel.example .env     (o compose le .env automaticamente)
#
# NAO comite o .env. Nenhum token do Splunk fica dentro dos Dockerfiles.
# =============================================================================

# Realm da sua org (aparece na URL do Splunk Observability). Ex.: us0, us1, eu0
SPLUNK_REALM=us1

# Aparece como "Environment" no APM e no RUM. Use o MESMO valor nos dois,
# senao frontend e backend caem em ambientes separados na UI.
DEPLOYMENT_ENV=lab-fiap
APP_VERSION=1.0.0

# --- RUM (browser) ----------------------------------------------------------
# ATENCAO: este NAO e' o SPLUNK_ACCESS_TOKEN de ingest do collector.
# Crie em: Settings > Access Tokens > (token) > Authorization Scopes > RUM.
# Ele fica visivel no HTML da pagina - isso e' esperado para RUM.
SPLUNK_RUM_TOKEN=
SPLUNK_RUM_APP_NAME=martian-bank-ui

# --- Exporters --------------------------------------------------------------
# Logs das apps Python via OTLP, correlacionados com o trace.
# ATENCAO: o Splunk Observability Cloud NAO aceita mais ingestao direta de logs
# (o endpoint /v1/log responde 404 ate sem token). Ligar isso contra ele so faz
# o collector entrar em retry infinito. Mude para otlp quando tiver um HEC de
# Splunk Cloud/Enterprise apontado em SPLUNK_HEC_URL.
OTEL_LOGS_EXPORTER=none

# Metricas custom consomem cota de MTS da org. O APM nao precisa delas (as
# metricas de servico sao derivadas dos spans). Para ligar: otlp
OTEL_METRICS_EXPORTER=none

# AlwaysOn Profiling tambem depende do pipeline HEC. Para ligar: true
SPLUNK_PROFILER_ENABLED=false

# --- MongoDB ----------------------------------------------------------------
# Variante A (network_mode: host)
DB_URL=mongodb://localhost:27017/martianbank
# Variante B (bridge + host.docker.internal)
DB_URL_BRIDGE=mongodb://host.docker.internal:27017/martianbank
